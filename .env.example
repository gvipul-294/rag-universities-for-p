# Embeddings. "fastembed" runs locally on CPU and needs no API key.
# Set EMBEDDING_PROVIDER=openai (plus OPENAI_API_KEY) to use OpenAI embeddings.
# Changing the provider or model requires re-running `ingest`.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where downloaded embedding weights are cached (default: <project>/.cache/fastembed).
# FASTEMBED_CACHE_PATH=

# Answer model for `ask` / `recommend`: any OpenAI-compatible chat endpoint.
# Groq (default): free key from https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-120b

# Only needed if EMBEDDING_PROVIDER=openai or LLM_BASE_URL is left empty.
OPENAI_API_KEY=

# Local open-weight answer model for `phd-rag agent`.
# Ollama must be running locally and the model must be pulled first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Evidence gates for the MCP retrieval/refinement loop.
AGENT_MIN_TOP_SCORE=0.30
AGENT_MIN_UNIQUE_UNIVERSITIES=2
AGENT_MAX_RETRIEVAL_ATTEMPTS=2

# HTTP API configuration. Add the exact deployed frontend URL before production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional for local development; required before exposing the API publicly.
# Keep this secret in the backend environment only, not in browser JavaScript.
PHD_RAG_API_TOKEN=
