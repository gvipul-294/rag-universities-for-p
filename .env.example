# Copy to .env, then replace with your API key.
OPENAI_API_KEY=your_openai_api_key

# Models can be changed without modifying source code.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# Local open-weight answer model for `phd-rag agent`.
# Ollama must be running locally and the model must be pulled first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Evidence gates for the MCP retrieval/refinement loop.
AGENT_MIN_TOP_SCORE=0.30
AGENT_MIN_UNIQUE_UNIVERSITIES=2
AGENT_MAX_RETRIEVAL_ATTEMPTS=2

# HTTP API configuration. Add the exact deployed frontend URL before production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional for local development; required before exposing the API publicly.
# Keep this secret in the backend environment only, not in browser JavaScript.
PHD_RAG_API_TOKEN=
